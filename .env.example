# Copy to .env.local for local development. NEVER commit real values: .env* files are git-ignored.
# In production set every variable below in Vercel (Project > Settings > Environment Variables, or `vercel env add NAME production`).

# --- Site -------------------------------------------------------------------------------------------------------
# Public URL, used for links inside emails (the "Open admin portal" button).
APP_URL="https://doctorsofwhisky.com.au"

# --- Email: Zoho Mail SMTP (orders, confirmations, contact form and admin replies) -----------------------------------
# AU data centre: smtp.zoho.com.au. Use smtp.zoho.com if the mailbox lives in the global data centre.
ZOHO_SMTP_HOST="smtp.zoho.com.au"
# 465 = implicit SSL (recommended), 587 = STARTTLS
ZOHO_SMTP_PORT="465"
ZOHO_SMTP_USER="sales@doctorsofwhisky.com.au"
# SECRET. Use a Zoho "app-specific password" (Zoho Accounts > Security > App Passwords), not the mailbox login password.
ZOHO_SMTP_PASS=""
# Where new-order notifications and contact messages go (defaults to ZOHO_SMTP_USER).
SALES_EMAIL="sales@doctorsofwhisky.com.au"
MAIL_FROM_NAME="Doctors of Whisky"
# Set to 1 to build emails but never connect or send (safe for testing).
MAIL_DRY_RUN=""

# --- Admin portal (/admin) ---------------------------------------------------------------------------------------
# Generate both with: node scripts/hash-admin-password.mjs   (the hash contains $ characters, so keep the quotes)
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# --- Order storage (needed so the admin portal can list orders across serverless instances) ------------------------
# Vercel > Storage > Marketplace > Upstash Redis (free tier) injects these automatically. KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Legacy (AI Studio) -------------------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
